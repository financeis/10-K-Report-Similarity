# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# SEC EDGAR는 요청마다 '이름 이메일' 형식의 식별자를 요구합니다.
# https://www.sec.gov/os/accessing-edgar-data
EDGAR_IDENTITY="Your Name your.email@example.com"

# methods에 kind: openai 를 쓸 때만 필요합니다.
OPENAI_API_KEY=

# 관계도 판정(tenksim judge / eval-relations)에 씁니다. Jev: https://docs.typesafe.ai
TYPESAFE_API_KEY=
